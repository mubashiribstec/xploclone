# XploClone environment — copy to .env and fill in. NEVER commit .env.
# Every secret below starts EMPTY. Generate real values before any use:
#   API key:  python -c "import secrets; print(secrets.token_hex(32))"
#   Key hash: python -c "import hashlib; print(hashlib.sha256(b'YOUR_KEY_HERE').hexdigest())"
#   Web password hash: python -c "import hashlib; print(hashlib.sha256(b'YOUR_WEB_PASSWORD').hexdigest())"
#   Session secret: python -c "import secrets; print(secrets.token_hex(32))"
# There is no default / dev key in this repo. If a key was ever used that
# appeared in an earlier public commit, rotate it — do not reuse it.

# --- API auth ---------------------------------------------------------------
# SHA-256 hex of the admin API key (leave empty until you generate one).
XPLOCLONE_API_KEY_HASH=

# --- Engine -----------------------------------------------------------------
# Device for Chatterbox Turbo: "cuda" on a GPU host, "cpu" for smoke tests only.
XPLOCLONE_DEVICE=cuda
# Directory holding the reference clips (private, never in git):
#   api/reference/mubashir-en-us.wav, mubashir-en-gb.wav (48 kHz WAV, see docs/)
# Leave empty until recordings exist — the engine then reports "unavailable".
XPLOCLONE_REF_DIR=api/reference
# Hugging Face revision pinned for ResembleAI/chatterbox-turbo (MIT).
# Verified 2026-10-30. Do not float.
XPLOCLONE_CHATTERBOX_REVISION=749d1c1a46eb10492095d68fbcf55691ccf137cd

# --- Limits -----------------------------------------------------------------
XPLOCLONE_RATE_LIMIT_PER_MIN=60
XPLOCLONE_QUEUE_MAX=10
XPLOCLONE_REQUEST_TIMEOUT_S=30
XPLOCLONE_MAX_CHARS=5000

# --- Web UI (Next.js proxy) -------------------------------------------------
# URL of the API from the web server (server-side only — the browser never
# sees this, and the API key never ships to the browser).
XPLOCLONE_API_URL=http://localhost:8000
# The same admin API key (plaintext) for the server-side proxy only.
# Leave empty until you generate one (see the top of this file).
# This file is gitignored. Never put this value in web/ code or in git.
XPLOCLONE_API_KEY=

# --- Web UI login (single-owner, see web/lib/web-auth.ts) --------------------
# SHA-256 hex of the web UI password. Empty = web UI refuses logins.
XPLOCLONE_WEB_PASSWORD_HASH=
# Random secret used to sign the web session cookie. Empty = no sessions.
XPLOCLONE_WEB_SESSION_SECRET=
